# SPDX-License-Identifier: EUPL-1.2
#
# Audit complet : enchaîne toutes les commandes dans le même dossier d'audit, continue si l'une
# échoue, puis produit la synthèse. Ordre : entetes, sf-crawl, seo, inventaire, liens, accessibilite,
# lighthouse, psi, unlighthouse, captures, synthese.
#
# Usage : bin/tout URL [--sans "psi,unlighthouse"] [--seulement "seo,liens"] [--max N]
#                      [--voisins "dom1.fr dom2.org"] [--dossier DOSSIER]
#   --sans       commandes à sauter (séparées par des virgules)
#   --seulement  commandes à lancer (la synthèse est toujours produite)
#   --max        nombre maximal de pages pour seo, inventaire, liens, accessibilite et unlighthouse
#   --voisins    domaines proches à tester dans bin/entetes
#
# bin/tout --liste-outils : une ligne par commande, dans l'ordre (nom, libellé et description
# séparés par des tabulations) ; lu par l'interface graphique.
#
# Sortie : tous les sous-dossiers des outils, journal.txt, manifeste.json et synthese/synthese.pdf
. "$(dirname "$(readlink -f "$0")")/../lib/commun.sh"
OPTIONS="--sans --seulement --max --voisins"
ORDRE=(entetes sf-crawl seo inventaire liens accessibilite lighthouse psi unlighthouse captures)
declare -A LIBELLES=(  # commande → « libellé|description »
  [entetes]="En-têtes et domaine|En-têtes de sécurité, redirections, certificat TLS, DNS et nom de domaine"
  [sf-crawl]="Screaming Frog|Crawl en trois passes avec Screaming Frog (version gratuite, 500 URL par passe)"
  [seo]="Référencement|Crawl complet avec advertools : titres, descriptions, H1, doublons, pages orphelines"
  [inventaire]="Inventaire|Contenus, métadonnées, liens, poids des images et vidéos YouTube"
  [liens]="Liens cassés|Liens internes et externes vérifiés avec lychee"
  [accessibilite]="Accessibilité|Problèmes WCAG 2.1 AA page par page avec pa11y-ci et axe"
  [lighthouse]="Lighthouse|Performance mesurée sur le poste, mobile et ordinateur, sur six pages types"
  [psi]="PageSpeed Insights|Mesures chez Google et données de vrais visiteurs (clé API nécessaire)"
  [unlighthouse]="Unlighthouse|Lighthouse sur toutes les pages du site"
  [captures]="Captures d'écran|Pages types sur ordinateur (1366 px) et sur téléphone (390 px)"
)
if [ "${1:-}" = --liste-outils ]; then
  for cmd in "${ORDRE[@]}"; do
    l="${LIBELLES[$cmd]:-$cmd|}"; printf '%s\t%s\t%s\n' "$cmd" "${l%%|*}" "${l#*|}"
  done
  exit 0
fi
lire_arguments "$@"
definir_dossier
verrouiller_dossier                           # avant de toucher à .etats.tsv et au journal
export KIT_AUDIT_DOSSIER="$DOSSIER_AUDIT"     # même dossier pour toutes les commandes, même après minuit
SANS=",${OPTS[--sans]:-},"; SEULEMENT="${OPTS[--seulement]:+,${OPTS[--seulement]},}"
JOURNAL="$DOSSIER_AUDIT/journal.txt"
ETATS="$DOSSIER_AUDIT/.etats.tsv"; : > "$ETATS"
journal "audit complet de $SITE_URL → $DOSSIER_AUDIT" 2>&1 | tee -a "$JOURNAL" >&2

lancer() {
  local cmd="$1"; shift
  local debut=$SECONDS
  journal "=== $cmd" 2>&1 | tee -a "$JOURNAL" >&2
  { "$KIT_RACINE/bin/$cmd" "$SITE_URL" "$@" 2>&1 | tee -a "$JOURNAL"; } 9>&-   # verrou non hérité (Chrome orphelin)
  local code=${PIPESTATUS[0]}
  DERNIER_CODE=$code
  printf '%s\t%s\t%s\n' "$cmd" "$code" "$((SECONDS - debut))" >> "$ETATS"
  [ "$code" -eq 0 ] || journal "$cmd a échoué (code $code) ; on continue" 2>&1 | tee -a "$JOURNAL" >&2
}

for cmd in "${ORDRE[@]}"; do
  [[ "$SANS" == *",$cmd,"* ]] && continue
  [ -n "$SEULEMENT" ] && [[ "$SEULEMENT" != *",$cmd,"* ]] && continue
  options=()
  case "$cmd" in
    seo|inventaire|liens|accessibilite|unlighthouse) [ -n "${OPTS[--max]:-}" ] && options+=(--max "${OPTS[--max]}") ;;
    entetes) [ -n "${OPTS[--voisins]:-}" ] && options+=(--voisins "${OPTS[--voisins]}") ;;
  esac
  lancer "$cmd" "${options[@]}"
done

# Manifeste : outils lancés, codes de retour, durées et versions
"$PYTHON" - "$DOSSIER_AUDIT" "$SITE_URL" 9>&- <<'PY'
import json, subprocess, sys
from pathlib import Path
d = Path(sys.argv[1])
def version(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout.strip().splitlines()[0]
    except Exception:
        return ""
outils = []
for ligne in (d / ".etats.tsv").read_text().splitlines():
    nom, code, duree = ligne.split("\t")
    outils.append({"outil": nom.replace("sf-crawl", "sf"), "code": int(code), "duree_s": int(duree)})
try:
    import advertools
    adv = advertools.__version__
except ImportError:
    adv = ""
versions = {
    "Screaming Frog": version("dpkg-query", "-W", "-f=${Version}", "screamingfrogseospider"),
    "Chrome": version("google-chrome", "--version").replace("Google Chrome ", ""),
    "Lighthouse": version("lighthouse", "--version"), "Unlighthouse": (version("unlighthouse-ci", "--version").split("/")[-1].split() or [""])[0],
    "pa11y-ci": version("pa11y-ci", "--version"), "lychee": version("lychee", "--version").replace("lychee ", ""),
    "advertools": adv,
}
manifeste = {"site": sys.argv[2], "dossier": str(d), "outils": outils, "versions": {k: v for k, v in versions.items() if v}}
(d / "manifeste.json").write_text(json.dumps(manifeste, ensure_ascii=False, indent=1), encoding="utf-8")
PY
lancer synthese
rm -f "$ETATS"
if [ "$DERNIER_CODE" -eq 0 ]; then
  journal "terminé : $DOSSIER_AUDIT/synthese/synthese.pdf" 2>&1 | tee -a "$JOURNAL" >&2
else
  journal "terminé sans nouvelle synthèse (échec de bin/synthese) : résultats dans $DOSSIER_AUDIT" 2>&1 | tee -a "$JOURNAL" >&2
fi
