# MariaDB réglé au minimum pour le Raspberry Pi (monté par compose.garde-fous.yaml uniquement).
# SEOnaut n'utilise que quelques connexions et des tables modestes pour un petit site.
[mariadb]
performance_schema = OFF
innodb_buffer_pool_size = 32M
innodb_log_buffer_size = 4M
innodb_log_file_size = 32M
innodb_ft_cache_size = 1600000
innodb_ft_total_cache_size = 32000000
aria_pagecache_buffer_size = 8M
key_buffer_size = 1M
max_connections = 20
thread_cache_size = 4
table_open_cache = 200
table_definition_cache = 400
tmp_table_size = 8M
max_heap_table_size = 8M
sort_buffer_size = 1M
join_buffer_size = 1M
read_buffer_size = 128K
read_rnd_buffer_size = 256K
loose-query_cache_type = 0
loose-query_cache_size = 0
skip_name_resolve = ON
