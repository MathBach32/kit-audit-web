# Modèle du fichier .env de SEOnaut. initialiser.sh le copie en .env (droits 600) et génère
# les mots de passe. Le fichier .env n'est jamais versionné.

# Garde-fous du Raspberry Pi actifs. Pour les lever sur une machine plus puissante :
#   COMPOSE_FILE=compose.yaml
COMPOSE_FILE=compose.yaml:compose.garde-fous.yaml

SEONAUT_IMAGE=seonaut-kit:880b312
SEONAUT_PORT=9100
SEONAUT_DB_ROOT_PASSWORD=
SEONAUT_DB_PASSWORD=

# Seuils de demarrer.sh, en Mo de mémoire disponible (appliqués quand les garde-fous sont actifs) :
# refus de démarrer en dessous de SEUIL_DEMARRAGE_MO, arrêt automatique en dessous de SEUIL_ALERTE_MO.
SEUIL_DEMARRAGE_MO=350
SEUIL_ALERTE_MO=100
